{
  "llm_base_url_default": "https://api.neuraldeep.ru/v1",
  "api_key_env_names": ["LLM_API_KEY", "NEURALDEEP_API_KEY", "OPENAI_API_KEY", "API_KEY"],
  "base_url_env_names": ["LLM_BASE_URL", "NEURALDEEP_BASE_URL", "OPENAI_BASE_URL", "BASE_URL", "API_BASE", "API_URL"],
  "api_key_optional": false,
  "models": {
    "all": ["qwen3.8-27b", "qwen3.8-27b-noreason", "qwen3.6-35b-a3b", "qwen3.6-35b-a3b-noreason"],
    "stage1": "qwen3.6-35b-a3b-noreason",
    "stage2": "qwen3.6-35b-a3b-noreason"
  },
  "model_map": {},
  "accounting": {
    "input_weight": 0.1,
    "reasoning_in_completion": true,
    "missing_usage_chars_per_token": 2.5
  },
  "budget_default": 100000,
  "parallel_sessions": 5,
  "llm": {
    "temperature": 0.0,
    "max_output_tokens": 2048,
    "timeout_sec": 180,
    "max_inflight": 3,
    "rate_limit_retries": 3,
    "rate_limit_wait_sec": [2, 30],
    "network_retries": 2,
    "network_retry_wait_sec": 5,
    "network_error_markers": ["APIConnectionError", "InternalServerError"]
  },
  "stage1": {
    "attempts": 2,
    "script_timeout_sec": 60,
    "error_tail_chars": 1500,
    "compact_test_output": true,
    "unsolvable_enabled": false,
    "unsolvable_marker": "UNSOLVABLE",
    "tail_prompts": {"search": "stage1_tail_search.txt", "math": "stage1_tail.txt", "data_analysis": "stage1_tail.txt"},
    "patch_types": ["coding"],
    "patch_prompts": {"system": "system_patch.txt", "retry": "stage1_retry_patch.txt"}
  },
  "stage2": {
    "max_steps": 6,
    "max_step_tokens": 1024,
    "script_timeout_sec": 60,
    "obs_tail_chars": 1200,
    "test_feedback": true
  },
  "success_model_file": "success_model.json",
  "snapshot": {
    "max_file_chars": 6000,
    "max_total_chars": 24000,
    "csv_sample_rows": 5,
    "test_output_chars": 2500,
    "compact_test_output": true,
    "trim_passing_tests": true,
    "passing_tests_note": "# {n} passing tests omitted",
    "kb_min_files": 6,
    "kb_follow_depth": 3,
    "kb_max_files": 12,
    "kb_omitted_note": "(+{n} more files not linked to the names in the task; not shown)"
  },
  "cost_model_file": "cost_model.json",
  "feasibility": {
    "enabled": true,
    "skip_severities": ["hard"],
    "config_file": "feasibility.json"
  },
  "rules": {
    "enabled": true,
    "config_file": "rules.json"
  },
  "log_dir_default": "logs"
}
