{
  "files": {
    "extensions": ["py", "csv", "tsv", "json", "txt", "md", "xlsx", "yaml", "yml", "db", "sqlite"],
    "ignore": ["answer.txt"],
    "output_verbs": ["write", "create", "save", "produce", "output", "generate", "store", "put", "place", "dump", "export", "append", "record", "report"],
    "output_window_chars": 120,
    "soft_extensions": ["py"],
    "input_before_re": "(?:\\b(?:the|this|a|an)\\s+(?:csv\\s+|data\\s+|input\\s+)?file|\\b(?:in|from|read|reads|reading|open|opens|load|loads|parse|parses|inside|using)(?:\\s+the)?)\\s+`?$",
    "input_after_re": "^`?\\s+(?:has|have|contains|contain|lists|holds|stores|is in|with columns)\\b",
    "dir_before_re": "\\b(?:directory|folder|dir|in|inside|under|from)\\s+(?:the\\s+)?`?$",
    "dir_after_re": "^`?\\s+(?:contains|has|holds|lists|is a)\\b"
  },
  "data": {
    "columns_declared_re": "columns\\s+([A-Za-z_][\\w]*(?:\\s*,\\s*[A-Za-z_][\\w]*)+)",
    "column_triggers": {
      "units": ["units"],
      "price": ["price", "revenue"],
      "region": ["region '"],
      "product": ["product '"],
      "month": ["month"]
    },
    "value_filters": {
      "product": "product '([^']+)'",
      "region": "region '([^']+)'"
    },
    "months_re": "months?\\s+(\\d+)\\s+(?:through|to|-)\\s+(\\d+)",
    "max_bytes": 50000000
  },
  "math": {
    "vague_re": "\\b(an unknown number of|a certain number of|an unspecified number of|some|several|a few|a number of)\\s+[a-z]+",
    "vague_hard_re": "\\b(?:an unknown number of|a certain number of|an unspecified number of|a number of)\\s+[a-z]+|\\b(?:ships|sells|receives|for)\\s+(?:some|several|a few)\\s+[a-z]+|\\bof\\s+(?:some|several|a few)\\s+[a-z]+\\s+each\\b",
    "zero_res": ["\\binto 0(?![.,]\\d)\\b", "\\bdivided (?:equally )?by 0(?![.,]\\d)\\b", "\\bamong 0(?![.,]\\d)\\b", "\\bbetween 0(?![.,]\\d)\\b(?! and\\b)"],
    "unit_re": "how many ([a-z]+)"
  },
  "search": {
    "max_files": 5000,
    "attributes": {
      "born": {"keywords": ["born", "birth"], "labels": ["born", "birth year", "year of birth", "birth"]},
      "headquarters": {"keywords": ["headquarters", "head office", "hq"], "labels": ["headquarters", "head office", "hq"]},
      "founded": {"keywords": ["founded", "established"], "labels": ["founded", "established"]}
    },
    "relations": {
      "employer": {"keywords": ["employer", "works for", "work for", "works at"], "labels": ["employer", "company", "works at"]},
      "mentor": {"keywords": ["mentor"], "labels": ["mentor"]}
    },
    "name_stopwords": ["In", "Which", "What", "When", "Where", "Who", "Whom", "Whose", "How", "The", "A", "An", "Is", "Was", "Does", "Did"]
  }
}
